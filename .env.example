# Copy this file to .env.local for local development, and set the same
# values in your hosting platform's environment variables for production
# (e.g. Vercel → Project Settings → Environment Variables).

# Required for the contact form to actually send emails.
# Get a free API key at https://resend.com (free tier: 3,000 emails/month).
RESEND_API_KEY=

# Optional — the inbox that receives contact form submissions.
# Defaults to the email set in data/site.ts if not set.
CONTACT_TO_EMAIL=

# Optional — the "from" address emails are sent as. Must be on a domain
# you've verified in Resend. Defaults to Resend's shared sandbox sender
# (onboarding@resend.dev), which works immediately with no setup but is
# meant for testing only — verify your own domain in Resend before relying
# on this for real inquiries.
CONTACT_FROM_EMAIL=
